# Lavoro Syrio — dati REALI (progetto next-move---crm).
# Copia in .env.local (escluso da git) e compila con la configurazione dell'app web.
# Nessun segreto qui: le variabili VITE_ finiscono nel codice scaricato dal browser.
VITE_APP_ENV=work
VITE_FIREBASE_API_KEY=<api-key-app-web-lavoro>
VITE_FIREBASE_AUTH_DOMAIN=<progetto-lavoro>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<progetto-lavoro>
VITE_FIREBASE_STORAGE_BUCKET=<bucket-lavoro>
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<app-id>
VITE_SENTRY_DSN=
VITE_MICROSOFT_CLIENT_ID=
