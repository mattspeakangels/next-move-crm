rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firebase Storage non è usato: PDF, documenti e foto sono salvati a blocchi in Firestore.
    // La regola precedente consentiva a qualsiasi utente autenticato di leggere i file di
    // tutti: con più aziende sarebbe una fuga di dati. Chiuso finché non serve davvero.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
