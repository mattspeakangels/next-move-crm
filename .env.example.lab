# Laboratorio Syrio — SOLO dati simulati.
# Copia in lab/env/.env.lab (cartella esclusa da git) e compila con la configurazione
# dell'app web del progetto syrio-lab (firebase apps:sdkconfig web --project syrio-lab).
# Nessun segreto qui: le variabili VITE_ finiscono nel codice scaricato dal browser.
VITE_APP_ENV=lab
VITE_FIREBASE_API_KEY=<api-key-app-web-syrio-lab>
VITE_FIREBASE_AUTH_DOMAIN=syrio-lab.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=syrio-lab
VITE_FIREBASE_STORAGE_BUCKET=<bucket-europe-west8-del-laboratorio>
VITE_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
VITE_FIREBASE_APP_ID=<app-id>
